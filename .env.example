# ==============================================================================
# AUTONOMOUS AI MINECRAFT ARCHITECT BOT - KONFIGURATION (STAND: ENDE 2026)
# ==============================================================================

# --- MINECRAFT SERVER ---
MC_HOST=127.0.0.1
MC_PORT=25565
MC_USERNAME=BaumeisterKI
MC_AUTH=offline                        # 'offline' oder 'microsoft'
MC_VERSION=1.20.4                      # Exakte Version oder 'false' für Auto-Detect
BOT_OWNER=DeinSpielerName

# --- AUSFÜHRUNGS- & SERVER-SCHUTZ-MODUS ---
# 'hybrid_visual' = Bot läuft hin, schwingt Arm, setzt via /setblock & /fill (Empfohlen mit OP)
# 'rcon_visual'   = Wie hybrid_visual, sendet Befehle aber über RCON (0 Chat-Spam-Risiko, 10x schneller!)
# 'pure_physical' = Echtes Platzieren aus dem Inventar ohne OP-Befehle
BUILD_EXECUTION_MODE=hybrid_visual
ENABLE_GREEDY_FILL_OPTIMIZATION=true   # Fasst gleiche Blöcke im hybrid/rcon-Modus zu /fill zusammen (-80% Befehle)
BUILD_OPERATIONS_PER_SECOND=12         # Sicherer Wert gegen Paper/Spigot Anti-Spam
MAX_BUILD_VOLUME_DIMENSION=64          # Maximale Kantenlänge X/Y/Z pro Auftrag

# --- OPTIONAL: RCON (Falls BUILD_EXECUTION_MODE=rcon_visual) ---
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=secret

# ==============================================================================
# MULTI-PROVIDER FREE-TIER LLM POOLS (STAND: ENDE 2026)
# Alle folgenden Anbieter bieten dauerhaft kostenlose Kontingente ohne Kreditkarte!
# ==============================================================================

# --- STUFE 1: HIGH-SPEED & AGENTIC LOOPS (Cerebras & Groq) ---
# Bis zu 2.600 Tokens/Sekunde & 1 Mio. Tokens/Tag gratis!
CEREBRAS_API_KEYS=csk_Key1,csk_Key2
CEREBRAS_FAST_MODEL=llama-3.3-70b
CEREBRAS_ARCHITECT_MODEL=gpt-oss-120b

# GroqCloud LPU (30-60 RPM, ultra-geringe Latenz)
GROQ_API_KEYS=gsk_Key1,gsk_Key2
GROQ_FAST_MODEL=llama-3.3-70b-versatile
GROQ_ARCHITECT_MODEL=openai/gpt-oss-120b

# --- STUFE 2: DEEP CONTEXT & CODE SYNTHESIS (Mistral / Codestral & Google AI Studio) ---
# Mistral AI (1 Mrd. Tokens/Monat gratis, dedizierter Codestral-Endpunkt)
MISTRAL_API_KEYS=mistral_Key1
CODESTRAL_API_KEYS=codestral_Key1
MISTRAL_FAST_MODEL=mistral-small-latest
MISTRAL_ARCHITECT_MODEL=codestral-2501

# Google AI Studio (15 RPM, bis 1.500 RPD, 1M Kontextfenster)
# Wichtig: gemini-2.5-flash nutzen (2.5-pro ist im Free Tier auf 25 RPD limitiert!)
GEMINI_API_KEYS=AIzaSyKey1,AIzaSyKey2
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_ARCHITECT_MODEL=gemini-2.5-flash

# --- STUFE 3: HEAVY REASONING & SPEZIAL-TASKS (SambaNova, Cloudflare & NVIDIA NIM) ---
# SambaNova Cloud (200K Tokens/Tag, automatische 20 RPD Schutzbegrenzung)
SAMBANOVA_API_KEYS=samba_Key1
SAMBANOVA_MODEL=DeepSeek-V3.1

# Cloudflare Workers AI (10.000 tägliche Neurons gratis)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/deepseek-ai/deepseek-r1-distill-qwen-32b

# NVIDIA NIM (40 RPM Prototyping)
NVIDIA_NIM_API_KEYS=nvapi-Key1
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- STUFE 4: UNBEGRENZTER FALLBACK-POOL (OpenRouter, Zhipu AI & SiliconFlow) ---
# OpenRouter (~30 dauerhaft kostenlose :free Modelle)
OPENROUTER_API_KEYS=sk-or-v1-Key1
OPENROUTER_FAST_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_ARCHITECT_MODEL=openai/gpt-oss-120b:free

# Zhipu AI BigModel (Dauerhaft kostenlose Flash-Linie)
ZHIPU_API_KEYS=
ZHIPU_MODEL=glm-4-flash

# SiliconFlow (Dauerhaft kostenlose L0-Tier Open-Weights)
SILICONFLOW_API_KEYS=
SILICONFLOW_MODEL=Qwen/Qwen3-8B

# --- ZERO-KEY EMERGENCY NOTFALL-FALLBACK ---
# Falls überhaupt keine API-Schlüssel konfiguriert sind, springt dieser schlüssellose Fallback ein:
ENABLE_ZERO_KEY_FALLBACK=true
KILO_GATEWAY_URL=https://api.kilo.ai/api/gateway
LLM7_GATEWAY_URL=https://api.llm7.io/v1
KILO_MODEL=kilo-auto/free
LLM7_MODEL=turbo

# --- MISSION CONTROL WEB-UI & 1-ACCOUNT HANDOFF ---
WEB_DASHBOARD_PORT=3080
PRISMARINE_VIEWER_PORT=3081
SINGLE_ACCOUNT_HANDOFF_MODE=true       # Pausiert Bot automatisch, wenn Owner selbst ins Spiel joint
SERVER_PING_INTERVAL_MS=10000          # Prüft im Standby alle 10s, ob der Account wieder frei ist
