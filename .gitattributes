# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Code, markup & config
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Windows scripts
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.schem binary
*.litematic binary
*.nbt binary
*.mca binary
*.vault binary
